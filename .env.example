# Copy to .env and fill in ONE of these. .env is gitignored — never commit it.

# https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Used automatically if GROQ_API_KEY is unset.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides
# SAFEGRID_PROVIDER=groq          # force one when both keys are set
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-opus-5
# SAFEGRID_PORT=8000
